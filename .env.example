# Required only when hosting behind HTTPS; local development works without .env.
# APP_ORIGIN=https://your-domain
# STAFF_DB_PATH=.data/staff.sqlite
# PORT=3001
# HOST=127.0.0.1
# NODE_ENV=production
# Automatic verified backups (while the server runs).
# BACKUP_ENABLED=true
# BACKUP_DIR=.backups
# BACKUP_INTERVAL_HOURS=24
# BACKUP_RETENTION_DAYS=30
